<policies>
    <inbound>
        <base />
        <!-- Product-scope JWT ownership must be checked before backend Managed Identity. -->
        <choose>
            <when condition="@(context.Variables.GetValueOrDefault&lt;string&gt;(&quot;jwtRequired&quot;, &quot;false&quot;).Equals(&quot;true&quot;, StringComparison.OrdinalIgnoreCase))">
                <include-fragment fragment-id="security-handler" />
            </when>
        </choose>
        
        <authentication-managed-identity resource="https://search.azure.com" output-token-variable-name="msi-access-token" client-id="{{uami-client-id}}" ignore-error="false" />
        <set-header name="Authorization" exists-action="override">
            <value>@("Bearer " + (string)context.Variables["msi-access-token"])</value>
        </set-header>
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>